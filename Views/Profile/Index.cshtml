@model StudentRegistrationWebApp.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<h1 class="h3 mb-3">My Profile</h1>

<dl class="row">
    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@(Model.Address ?? "Not specified")</dd>

    <dt class="col-sm-3">Registered On</dt>
    <dd class="col-sm-9">@Model.RegisteredOn.ToString("MMM dd, yyyy")</dd>
</dl>

<a asp-action="Edit" class="btn btn-primary">Edit Profile</a>

<h2 class="h4 mt-4 mb-3">My Courses</h2>
@{
    var regs = ViewData["Registrations"] as IEnumerable<dynamic>;
}
@if (regs != null && regs.Any())
{
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Description</th>
                <th>Registered On</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reg in regs)
            {
                <tr>
                    <td>@reg.CourseCode</td>
                    <td>@reg.Name</td>
                    <td>@reg.Description</td>
                    <td>@reg.RegisteredOn.ToString("MMM dd, yyyy")</td>
                    <td>
                        <form asp-controller="CourseRegistration" asp-action="Drop" method="post">
                            <input type="hidden" name="id" value="@reg.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Drop</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">You are not registered for any courses yet.</p>
    <a asp-controller="CourseRegistration" asp-action="Register" class="btn btn-outline-primary">Browse Courses</a>
}
