@model StudentRegistrationWebApp.Models.ApplicationUser
@{
    ViewData["Title"] = "Edit Profile";
}

<h1 class="h3 mb-3">Edit Profile</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input name="fullName" type="text" class="form-control" value="@Model.FullName" />
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <input name="address" type="text" class="form-control" value="@Model.Address" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
