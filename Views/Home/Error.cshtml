@{
    ViewData["Title"] = "Error";
    var statusCode = ViewData["StatusCode"] as int? ?? 500;
}

<div class="text-center mt-5">
    <h1 class="display-1 text-danger">@statusCode</h1>
    <h2 class="mb-3">
        @switch (statusCode)
        {
            case 404:
                <text>Page Not Found</text>
                break;
            case 403:
                <text>Access Denied</text>
                break;
            case 401:
                <text>Unauthorized</text>
                break;
            default:
                <text>Something went wrong</text>
                break;
        }
    </h2>
    <p class="text-muted mb-4">
        @switch (statusCode)
        {
            case 404:
                <text>The page you're looking for doesn't exist or has been moved.</text>
                break;
            case 403:
                <text>You don't have permission to access this page.</text>
                break;
            case 401:
                <text>Please log in to access this page.</text>
                break;
            default:
                <text>An unexpected error occurred. Please try again later.</text>
                break;
        }
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
</div>
