@model StudentRegistrationWebApp.Models.Course
@{
    ViewData["Title"] = "Delete Course";
}

<h1 class="h3 mb-3">Delete Course</h1>
<div class="alert alert-warning">Are you sure you want to delete this course?</div>

<dl class="row">
    <dt class="col-sm-3">Course Code</dt>
    <dd class="col-sm-9">@Model.CourseCode</dd>
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
