@model IEnumerable<StudentRegistrationWebApp.Models.Course>
@{
    ViewData["Title"] = "Register for Course";
}

<h1 class="h3 mb-3">Register for a Course</h1>
<p class="text-muted">You can register for only one course.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No courses available to register.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CourseCode</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td class="text-end">
                            <form asp-action="Register" method="post" style="display:inline;">
                                <input type="hidden" name="courseId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-success"
                                        onclick="return confirm('Register for @item.Name?');">Register</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
